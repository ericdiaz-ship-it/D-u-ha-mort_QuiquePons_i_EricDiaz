  m_Script: {fileID: 11500000, guid: 02b7231de15ba1e469c41151d0a4edb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Pistes
  panel: {fileID: 1704879173}
  textoTMP: {fileID: 1320745639}
  textoAMostrar: " PSALMUS XXIII : 1\u20134\r\n El Senyor \xE9s el meu pastor; res
    no em faltar\xE0. En llocs de pastures delicades em far\xE0 descansar; al costat
    d'aig\xFCes de rep\xF2s em pasturar\xE0. Consolar\xE0 la meva \xE0nima; em guiar\xE0
    per senders de just\xEDcia per amor del seu nom. Encara que camini per la vall
    de l'ombra de la mort, no temer\xE9 mal algun, perqu\xE8 tu ser\xE0s amb mi;
    la teva vara i el teu bast\xF3 m\u2019infondran \xE0nim.\r\n"
