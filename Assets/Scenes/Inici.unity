  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02b7231de15ba1e469c41151d0a4edb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Pistes
  panel: {fileID: 1704879173}
  textoTMP: {fileID: 1320745639}
  textoAMostrar: "JOHANNES XVII : 1\u20135\r\n Aquestes coses va parlar Jes\xFAs,
    i aixecant els ulls al cel, va dir: Pare, ha arribat l\u2019hora; glorifica el
    teu Fill, perqu\xE8 tamb\xE9 el teu Fill et glorifiqui a tu; com li has donat
    potestat sobre tota carn, perqu\xE8 doni vida eterna a tots els qui li has donat.
    I aquesta \xE9s la vida eterna: que coneguin a tu, l\u2019\xFAnic D\xE9u veritable,
    i a Jesucrist, a qui has enviat. Jo t\u2019he glorificat a la terra; he acabat
    l\u2019obra que em vas donar que fes. Ara, doncs, Pare, glorifica\u2019m tu al
    teu costat, amb aquella gl\xF2ria que vaig tenir amb tu abans que el m\xF3n fos.\r\n"
